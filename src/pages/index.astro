---
import ArrowRight from '@lucide/astro/icons/arrow-right'
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right'
import MapPin from '@lucide/astro/icons/map-pin'

import BaseLayout from '@/layouts/BaseLayout.astro'
import Uptime from '@/components/Uptime.astro'
import LiveVisitors from '@/components/LiveVisitors.astro'
import { work } from '@/data/work'
import { PROFILES } from '@/lib/site'

const featured = work.filter((w) => w.featured)
const highlights = [
  { value: '300+', label: 'sales reps working with my reports' },
  { value: '3', label: 'countries covered: DE · AT · CH' },
  { value: '~€150M', label: 'grid revenue I controlled at EWR' },
  { value: '1.3', label: 'M.Sc. Data Science, finished 2026' }
]
const toolkit = ['Power BI', 'SQL', 'Python', 'Excel / VBA', 'Power Automate', 'Astro', 'Docker']
const linkedin = PROFILES.find((p) => p.icon === 'linkedin')!
const github = PROFILES.find((p) => p.icon === 'github')!
---

<BaseLayout>
  <div class="page space-y-16">
    <!-- Intro -->
    <section class="flex flex-col-reverse gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-xl space-y-5">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <span class="inline-flex items-center gap-1.5 font-mono text-xs text-faint">
            <MapPin size={13} aria-hidden="true" /> Mannheim, Germany
          </span>
          <LiveVisitors />
        </div>
        <h1 class="text-4xl font-semibold sm:text-5xl">Hi, I'm Tim.</h1>
        <p class="text-lg text-muted">
          Data Analyst at <span class="text-fg">Essity</span>, turning raw data into the numbers people actually use for
          their day-to-day decisions. Before that I was a grid controller at EWR Netz – which is where I learned that
          most problems are really data problems.
        </p>
        <p class="font-mono text-sm text-faint">
          <span class="text-accent">●</span> Currently: Data Analyst at Essity · freshly graduated M.Sc. Data Science
        </p>
      </div>
      <img
        src="/assets/me.jpeg"
        alt="Portrait of Tim Darmstaedter"
        width="144"
        height="144"
        class="size-24 shrink-0 rounded-2xl object-cover ring-1 ring-line sm:size-36"
        fetchpriority="high"
      />
    </section>

    <!-- Highlights -->
    <section aria-label="Highlights">
      <dl class="grid border-y border-line sm:grid-cols-2 md:grid-cols-4">
        {
          highlights.map((h, i) => (
            <div class:list={['flex flex-col-reverse py-5 sm:px-5', i > 0 && 'border-t border-line', i % 2 === 1 && 'sm:border-l', i === 1 && 'sm:border-t-0', i > 1 && 'md:border-t-0 md:border-l', i % 2 === 0 && 'sm:pl-0', i === 2 && 'md:pl-5']}>
              <dt class="mt-1 text-sm text-muted">{h.label}</dt>
              <dd class="num text-3xl font-medium tracking-tight text-fg">{h.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- Uptime gimmick -->
    <Uptime />

    <!-- Selected work -->
    <section>
      <h2 class="section-title">
        Selected work
        <a href="/work" class="inline-flex items-center gap-1 text-xs font-normal text-muted hover:text-fg">
          All work <ArrowRight size={13} aria-hidden="true" />
        </a>
      </h2>
      <ul class="divide-y divide-line">
        {
          featured.map((item) => (
            <li>
              <a href={`/work#${item.slug}`} class="group -mx-3 grid gap-1 rounded-lg px-3 py-4 transition-colors duration-150 hover:bg-subtle sm:grid-cols-[8rem_1fr] sm:gap-6">
                <span class="eyebrow pt-0.5">{item.period}</span>
                <span>
                  <span class="flex items-center gap-1.5 font-medium text-fg">
                    {item.title}
                    <ArrowRight size={14} class="text-faint opacity-0 transition-opacity duration-150 group-hover:opacity-100" aria-hidden="true" />
                  </span>
                  <span class="mt-1 block text-sm text-muted">{item.summary}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Toolkit -->
    <section>
      <h2 class="section-title">
        Toolkit
        <a href="/techstack" class="inline-flex items-center gap-1 text-xs font-normal text-muted hover:text-fg">
          Full stack <ArrowRight size={13} aria-hidden="true" />
        </a>
      </h2>
      <ul class="flex flex-wrap gap-2">
        {toolkit.map((t) => <li class="rounded-md border border-line bg-surface px-2.5 py-1 text-sm text-muted">{t}</li>)}
      </ul>
    </section>

    <!-- Contact -->
    <section class="rounded-xl border border-line bg-surface p-6">
      <h2 class="text-lg font-medium">Want to get to know me better?</h2>
      <p class="mt-1 text-muted">Happy to talk about data, dashboards or home labs. LinkedIn is the fastest way to reach me.</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a
          href={linkedin.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-10 items-center gap-2 rounded-md bg-fg px-4 text-sm font-medium text-bg transition-opacity duration-150 hover:opacity-85"
        >
          Message me on LinkedIn <ArrowUpRight size={15} aria-hidden="true" />
        </a>
        <a
          href={github.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-10 items-center gap-2 rounded-md border border-line px-4 text-sm font-medium text-fg transition-colors duration-150 hover:bg-subtle"
        >
          GitHub <ArrowUpRight size={15} aria-hidden="true" />
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
