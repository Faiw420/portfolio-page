---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHeader from '@/components/PageHeader.astro'
import { getOverview, getPageviews, getTimeRange } from '@/lib/umami'

export const prerender = false

let initial = null
try {
  const { startAt, endAt, unit } = getTimeRange('24h')
  const [overview, series] = await Promise.all([getOverview('24h'), getPageviews(startAt, endAt, unit)])
  initial = { overview, series: { ...series, unit } }
} catch (error) {
  console.error('Failed to fetch initial stats:', error)
}

const ranges = [
  { id: '24h', label: '24h' },
  { id: '7d', label: '7 days' },
  { id: '30d', label: '30 days' }
]
const kpis = [
  { key: 'pageviews', label: 'Pageviews' },
  { key: 'visitors', label: 'Visitors' },
  { key: 'bounceRate', label: 'Bounce rate' },
  { key: 'avgDuration', label: 'Avg. visit' }
]
const lists = [
  { key: 'topPages', label: 'Pages', metric: 'views' },
  { key: 'referrers', label: 'Sources' },
  { key: 'countries', label: 'Countries' },
  { key: 'devices', label: 'Devices' },
  { key: 'browsers', label: 'Browsers' }
]
---

<BaseLayout title="Stats" description="Live analytics for this website, powered by a self-hosted Umami instance.">
  <div class="page lg:max-w-4xl">
    <PageHeader eyebrow="05 / Stats" title="This site, by the numbers">
      A small live dashboard about its own visitors, served from my self-hosted, cookie-free Umami instance. Refreshes
      every 60 seconds.
    </PageHeader>

    <div id="stats" data-initial={JSON.stringify(initial)} class="space-y-10">
      <!-- Controls -->
      <div class="flex flex-wrap items-center justify-between gap-4">
        <p class="flex items-center gap-2 font-mono text-xs text-muted">
          <span class="relative flex size-2" aria-hidden="true">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-live opacity-60"></span>
            <span class="relative inline-flex size-2 rounded-full bg-live"></span>
          </span>
          <span><span class="num text-fg" data-s="active">–</span> online now</span>
          <span class="text-faint" data-s="updated" aria-live="polite"></span>
        </p>
        <div role="radiogroup" aria-label="Time range" class="inline-flex rounded-lg border border-line bg-surface p-0.5">
          {
            ranges.map((r, i) => (
              <button
                type="button"
                role="radio"
                aria-checked={i === 0 ? 'true' : 'false'}
                data-range={r.id}
                class="min-h-8 rounded-md px-3 font-mono text-xs text-muted transition-colors duration-150 hover:text-fg aria-checked:bg-fg aria-checked:text-bg"
              >
                {r.label}
              </button>
            ))
          }
        </div>
      </div>

      <p data-s="error" hidden class="rounded-lg border border-danger/40 px-4 py-3 text-sm text-danger" role="alert">
        Couldn't load analytics right now. The Umami API might be down – try again in a minute.
      </p>

      <!-- KPIs -->
      <dl class="grid grid-cols-2 rounded-xl border border-line bg-surface sm:grid-cols-4">
        {
          kpis.map((k, i) => (
            <div
              class:list={[
                'flex flex-col-reverse gap-1 p-4',
                i % 2 === 1 && 'border-l border-line',
                i > 1 && 'border-t border-line sm:border-t-0',
                i === 2 && 'sm:border-l'
              ]}
            >
              <dt class="font-mono text-[11px] text-faint">{k.label}</dt>
              <dd class="num text-2xl font-medium tracking-tight text-fg" data-kpi={k.key}>
                –
              </dd>
            </div>
          ))
        }
      </dl>

      <!-- Pageviews over time -->
      <section aria-labelledby="chart-title">
        <h2 id="chart-title" class="section-title">
          Pageviews over time
          <span class="font-mono text-xs font-normal text-faint" data-s="unit"></span>
        </h2>
        <div class="relative" data-s="chart-wrap">
          <svg data-s="chart" class="h-56 w-full overflow-visible" role="img" aria-labelledby="chart-title"></svg>
          <div
            data-s="tooltip"
            hidden
            class="pointer-events-none absolute top-0 z-10 rounded-md border border-line bg-surface px-2.5 py-1.5 font-mono text-xs whitespace-nowrap shadow-sm"
          >
          </div>
          <p data-s="chart-empty" hidden class="absolute inset-0 grid place-content-center text-sm text-faint">
            No pageviews in this range yet.
          </p>
        </div>
        <details class="mt-3 text-sm">
          <summary class="cursor-pointer font-mono text-xs text-faint hover:text-fg">Show as table</summary>
          <div class="mt-3 max-h-64 overflow-y-auto rounded-lg border border-line">
            <table class="w-full text-left text-sm">
              <thead class="sticky top-0 bg-surface font-mono text-xs text-faint">
                <tr><th class="px-3 py-2 font-normal">Time</th><th class="px-3 py-2 text-right font-normal">Pageviews</th><th class="px-3 py-2 text-right font-normal">Sessions</th></tr>
              </thead>
              <tbody data-s="table" class="num divide-y divide-line text-muted"></tbody>
            </table>
          </div>
        </details>
      </section>

      <!-- Breakdown lists -->
      <div class="grid gap-x-10 gap-y-10 md:grid-cols-2">
        {
          lists.map((l) => (
            <section>
              <h2 class="section-title">
                {l.label}
                <span class="font-mono text-xs font-normal text-faint">{l.metric ?? 'visitors'}</span>
              </h2>
              <ul class="space-y-1" data-list={l.key}>
                <li class="text-sm text-faint">Loading…</li>
              </ul>
            </section>
          ))
        }
      </div>

      <p class="font-mono text-xs text-faint">Powered by Umami · no cookies, no personal data.</p>
    </div>
  </div>
</BaseLayout>

<script>
  type Point = { x: string; y: number }
  const root = document.getElementById('stats')!
  const $ = <T extends Element = HTMLElement>(k: string) => root.querySelector<T>(`[data-s="${k}"]`)!
  const nf = new Intl.NumberFormat('en-US')
  const NS = 'http://www.w3.org/2000/svg'

  const COUNTRY = new Intl.DisplayNames(['en'], { type: 'region' })
  const countryName = (code: string) => {
    try {
      return COUNTRY.of(code) ?? code
    } catch {
      return code || 'Unknown'
    }
  }

  const formatDuration = (s: number) => {
    if (s < 60) return `${s}s`
    const m = Math.floor(s / 60)
    return m < 60 ? `${m}m ${s % 60}s` : `${Math.floor(m / 60)}h ${m % 60}m`
  }

  const parseDate = (x: string) => new Date(/[zZ]|[+-]\d\d:?\d\d$/.test(x) ? x : x.replace(' ', 'T') + 'Z')

  let range = '24h'
  let unit = 'hour'

  // ---------- KPIs ----------
  function renderKpis(stats: any) {
    const values: Record<string, string> = {
      pageviews: nf.format(stats?.pageviews ?? 0),
      visitors: nf.format(stats?.visitors ?? 0),
      bounceRate: `${stats?.bounceRate ?? 0}%`,
      avgDuration: formatDuration(stats?.avgDuration ?? 0)
    }
    root.querySelectorAll<HTMLElement>('[data-kpi]').forEach((el) => (el.textContent = values[el.dataset.kpi!]))
  }

  // ---------- Bar lists ----------
  const listConfig: Record<string, { label: (d: any) => string; value: (d: any) => number }> = {
    topPages: { label: (d) => (d.path === '/' ? '/ (home)' : d.path), value: (d) => d.views },
    referrers: { label: (d) => d.source || 'Direct', value: (d) => d.visits },
    countries: { label: (d) => countryName(d.country), value: (d) => d.visitors },
    devices: { label: (d) => d.device || 'Unknown', value: (d) => d.count },
    browsers: { label: (d) => d.browser || 'Unknown', value: (d) => d.count }
  }

  function renderList(key: string, rows: any[] = []) {
    const ul = root.querySelector<HTMLElement>(`[data-list="${key}"]`)!
    const cfg = listConfig[key]
    ul.replaceChildren()
    if (!rows.length) {
      ul.innerHTML = '<li class="text-sm text-faint">No data in this range.</li>'
      return
    }
    const max = Math.max(...rows.map(cfg.value), 1)
    for (const row of rows) {
      const v = cfg.value(row)
      const li = document.createElement('li')
      li.className = 'relative flex min-h-8 items-center justify-between gap-3 rounded-md px-2.5 text-sm'
      li.innerHTML = `<span class="absolute inset-y-0 left-0 rounded-md bg-chart/12 dark:bg-chart/20" style="width:${(v / max) * 100}%"></span>
        <span class="relative truncate text-fg ${key === 'devices' || key === 'browsers' ? 'capitalize' : ''}"></span>
        <span class="num relative shrink-0 text-muted">${nf.format(v)}</span>`
      li.children[1].textContent = cfg.label(row)
      ul.append(li)
    }
  }

  // ---------- Line chart ----------
  const svg = $<SVGSVGElement>('chart')
  const tooltip = $('tooltip')
  let points: { t: Date; pv: number; s: number }[] = []

  const labelFor = (d: Date, long = false) =>
    unit === 'hour'
      ? d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', ...(long && { weekday: 'short' }) })
      : d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', ...(long && { weekday: 'short' }) })

  function el(name: string, attrs: Record<string, string | number>) {
    const node = document.createElementNS(NS, name)
    for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v))
    return node
  }

  function niceMax(v: number) {
    if (v <= 4) return 4
    const mag = 10 ** Math.floor(Math.log10(v))
    return [1, 2, 2.5, 5, 10].map((m) => m * mag).find((m) => m >= v)!
  }

  function renderChart() {
    svg.replaceChildren()
    $('chart-empty').hidden = points.some((p) => p.pv > 0)
    if (points.length < 2) return

    const W = svg.clientWidth || 600
    const H = svg.clientHeight || 224
    const pad = { t: 8, r: 8, b: 24, l: 32 }
    const iw = W - pad.l - pad.r
    const ih = H - pad.t - pad.b
    const yMax = niceMax(Math.max(...points.map((p) => p.pv)))
    const x = (i: number) => pad.l + (i / (points.length - 1)) * iw
    const y = (v: number) => pad.t + ih - (v / yMax) * ih
    svg.setAttribute('viewBox', `0 0 ${W} ${H}`)

    // Grid + y labels (recessive)
    for (let i = 0; i <= 4; i++) {
      const v = (yMax / 4) * i
      svg.append(el('line', { x1: pad.l, x2: W - pad.r, y1: y(v), y2: y(v), stroke: 'var(--line)', 'stroke-width': 1 }))
      const t = el('text', { x: pad.l - 8, y: y(v) + 3, 'text-anchor': 'end', class: 'fill-faint font-mono text-[10px]' })
      t.textContent = nf.format(v)
      svg.append(t)
    }
    // X labels: ~5 evenly spaced
    const step = Math.max(1, Math.ceil(points.length / 5))
    points.forEach((p, i) => {
      if (i % step !== 0) return
      const t = el('text', { x: x(i), y: H - 6, 'text-anchor': i === 0 ? 'start' : 'middle', class: 'fill-faint font-mono text-[10px]' })
      t.textContent = labelFor(p.t)
      svg.append(t)
    })

    const line = points.map((p, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(p.pv).toFixed(1)}`).join('')
    const area = `${line}L${x(points.length - 1)},${y(0)}L${x(0)},${y(0)}Z`
    svg.append(el('path', { d: area, fill: 'var(--chart)', 'fill-opacity': 0.08 }))
    svg.append(el('path', { d: line, fill: 'none', stroke: 'var(--chart)', 'stroke-width': 2, 'stroke-linejoin': 'round', 'stroke-linecap': 'round' }))

    // Hover layer
    const cross = el('line', { y1: pad.t, y2: pad.t + ih, stroke: 'var(--line-strong)', 'stroke-width': 1, visibility: 'hidden' })
    const dot = el('circle', { r: 4, fill: 'var(--chart)', stroke: 'var(--surface)', 'stroke-width': 2, visibility: 'hidden' })
    const hit = el('rect', { x: pad.l, y: pad.t, width: iw, height: ih, fill: 'transparent' })
    svg.append(cross, dot, hit)

    const show = (clientX: number) => {
      const box = svg.getBoundingClientRect()
      const rel = ((clientX - box.left) / box.width) * W
      const i = Math.round(((rel - pad.l) / iw) * (points.length - 1))
      const idx = Math.min(points.length - 1, Math.max(0, i))
      const p = points[idx]
      const px = x(idx)
      cross.setAttribute('x1', String(px))
      cross.setAttribute('x2', String(px))
      dot.setAttribute('cx', String(px))
      dot.setAttribute('cy', String(y(p.pv)))
      cross.setAttribute('visibility', 'visible')
      dot.setAttribute('visibility', 'visible')
      tooltip.innerHTML = `<div class="text-faint"></div><div class="text-fg">${nf.format(p.pv)} pageviews</div><div class="text-muted">${nf.format(p.s)} sessions</div>`
      tooltip.firstElementChild!.textContent = labelFor(p.t, true)
      tooltip.hidden = false
      const left = (px / W) * box.width
      tooltip.style.left = `${Math.min(Math.max(left - tooltip.offsetWidth / 2, 0), box.width - tooltip.offsetWidth)}px`
      tooltip.style.top = `${Math.max((y(p.pv) / H) * box.height - tooltip.offsetHeight - 12, 0)}px`
    }
    const hide = () => {
      cross.setAttribute('visibility', 'hidden')
      dot.setAttribute('visibility', 'hidden')
      tooltip.hidden = true
    }
    hit.addEventListener('pointermove', (e) => show((e as PointerEvent).clientX))
    hit.addEventListener('pointerleave', hide)
  }

  function renderSeries(series: any) {
    unit = series?.unit ?? unit
    const sessions = new Map((series?.sessions ?? []).map((s: Point) => [s.x, s.y]))
    points = (series?.pageviews ?? [])
      .map((p: Point) => ({ t: parseDate(p.x), pv: p.y, s: (sessions.get(p.x) as number) ?? 0 }))
      .sort((a: any, b: any) => a.t - b.t)
    $('unit').textContent = `per ${unit}`
    $('table').innerHTML = points
      .map((p) => `<tr><td class="px-3 py-1.5">${labelFor(p.t, true)}</td><td class="px-3 py-1.5 text-right">${nf.format(p.pv)}</td><td class="px-3 py-1.5 text-right">${nf.format(p.s)}</td></tr>`)
      .join('')
    renderChart()
  }

  function render(overview: any, series: any) {
    $('active').textContent = nf.format(Math.max(1, overview?.activeVisitors ?? 0))
    $('updated').textContent = `· updated ${new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })}`
    renderKpis(overview?.stats)
    for (const key of Object.keys(listConfig)) renderList(key, overview?.[key])
    renderSeries(series)
  }

  async function load() {
    root.setAttribute('aria-busy', 'true')
    try {
      const [o, t] = await Promise.all([
        fetch(`/api/stats/overview?range=${range}`).then((r) => (r.ok ? r.json() : Promise.reject())),
        fetch(`/api/stats/timeseries?range=${range}`).then((r) => (r.ok ? r.json() : Promise.reject()))
      ])
      $('error').hidden = true
      render(o, t)
    } catch {
      $('error').hidden = false
    } finally {
      root.removeAttribute('aria-busy')
    }
  }

  // Range control
  root.querySelectorAll<HTMLButtonElement>('[data-range]').forEach((btn) =>
    btn.addEventListener('click', () => {
      range = btn.dataset.range!
      root.querySelectorAll('[data-range]').forEach((b) => b.setAttribute('aria-checked', String(b === btn)))
      load()
    })
  )

  // Initial (server-rendered) data, then refresh every minute
  const initial = JSON.parse(root.dataset.initial || 'null')
  if (initial) render(initial.overview, initial.series)
  else load()
  setInterval(load, 60_000)
  new ResizeObserver(() => renderChart()).observe($('chart-wrap'))
</script>
