---
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout title="Not found">
  <div class="page">
    <p class="eyebrow mb-3">Error 404</p>
    <h1 class="text-3xl font-semibold sm:text-4xl">This page returned 0 rows.</h1>
    <p class="mt-3 max-w-md text-muted">
      You've found a page I didn't think anyone would look for. There's nothing to see here – but the
      <a href="/" class="text-link">home page</a> has plenty.
    </p>
    <pre class="mt-8 overflow-x-auto rounded-lg border border-line bg-surface p-4 font-mono text-xs text-muted"><code>SELECT * FROM pages WHERE path = '<span data-path>/…</span>';
-- (0 rows)</code></pre>
  </div>
  <script is:inline>
    document.querySelector('[data-path]').textContent = location.pathname
  </script>
</BaseLayout>
